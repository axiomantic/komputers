//! Integration tests for advanced algorithm-tensor binding functionality.
//!
//! These tests verify that the AlgorithmBinding system correctly validates
//! tensor bindings, applies templates, and provides comprehensive error
//! reporting for production GPU compute workflows.

use kompute::{
    AccessPattern, Algorithm, AlgorithmBinding, BindingTemplate, CommonBindingTemplates, Manager,
    ParameterSpec, Tensor, TensorDataType, ValidationRule,
};

#[test]
#[ignore = "requires GPU device and SPIR-V shaders"]
fn test_algorithm_binding_with_template() {
    if let Ok(mut manager) = Manager::new() {
        println!("Testing algorithm binding with elementwise template...");

        // Create test tensors
        let input_a = vec![1.0f32, 2.0, 3.0, 4.0];
        let input_b = vec![5.0f32, 6.0, 7.0, 8.0];
        let output_data = vec![0.0f32; 4];

        match (
            Tensor::new(&mut manager, &input_a),
            Tensor::new(&mut manager, &input_b),
            Tensor::new(&mut manager, &output_data),
        ) {
            (Ok(tensor_a), Ok(tensor_b), Ok(tensor_out)) => {
                // Use real SPIR-V from our spirv_shaders module
                let spirv_data = kompute::spirv_shaders::ELEMENTWISE_ADD_F32_SPIRV;

                match Algorithm::new(&mut manager, spirv_data) {
                    Ok(algorithm) => {
                        // Create binding with elementwise template
                        let template = CommonBindingTemplates::elementwise_binary_op();
                        match AlgorithmBinding::new(algorithm, Some(&template)) {
                            Ok(mut binding) => {
                                println!("✓ Algorithm binding created with template");

                                // Test individual tensor binding with validation
                                let bind_results = vec![
                                    binding.bind_tensor_validated(
                                        "input_a",
                                        &tensor_a,
                                        AccessPattern::Input,
                                    ),
                                    binding.bind_tensor_validated(
                                        "input_b",
                                        &tensor_b,
                                        AccessPattern::Input,
                                    ),
                                    binding.bind_tensor_validated(
                                        "output",
                                        &tensor_out,
                                        AccessPattern::Output,
                                    ),
                                ];

                                let successful_bindings =
                                    bind_results.iter().filter(|r| r.is_ok()).count();
                                println!(
                                    "✓ Successfully bound {} of 3 tensors",
                                    successful_bindings
                                );

                                // Test validation report
                                let report = binding.validation_report();
                                println!("Binding validation report:");
                                println!("  Valid: {}", report.is_valid);
                                println!("  Missing required: {:?}", report.missing_required);
                                println!(
                                    "  Performance warnings: {}",
                                    report.performance_warnings.len()
                                );

                                if report.is_valid {
                                    println!("✓ All tensor bindings validated successfully");
                                } else {
                                    println!("⚠️ Some binding validations failed (expected in some environments)");
                                }
                            }
                            Err(e) => println!("⚠️ Algorithm binding creation failed: {}", e),
                        }
                    }
                    Err(e) => println!("⚠️ Algorithm creation failed: {}", e),
                }
            }
            _ => println!("⚠️ Failed to create test tensors"),
        }
    } else {
        println!("⚠️ GPU manager not available");
    }
}

#[test]
#[ignore = "requires GPU device and SPIR-V shaders"]
fn test_algorithm_binding_batch_operations() {
    if let Ok(mut manager) = Manager::new() {
        println!("Testing algorithm binding batch operations...");

        // Create test tensors for matrix operations
        let matrix_a_data = vec![1.0f32; 16]; // 4x4 matrix
        let matrix_b_data = vec![2.0f32; 16]; // 4x4 matrix
        let matrix_c_data = vec![0.0f32; 16]; // 4x4 result matrix

        match (
            Tensor::new(&mut manager, &matrix_a_data),
            Tensor::new(&mut manager, &matrix_b_data),
            Tensor::new(&mut manager, &matrix_c_data),
        ) {
            (Ok(tensor_a), Ok(tensor_b), Ok(tensor_c)) => {
                // Use a simple SPIR-V shader for testing
                let spirv_data = kompute::spirv_shaders::MATRIX_MULT_F32_SPIRV;

                match Algorithm::new(&mut manager, spirv_data) {
                    Ok(algorithm) => {
                        let template = CommonBindingTemplates::matrix_multiply();
                        match AlgorithmBinding::new(algorithm, Some(&template)) {
                            Ok(mut binding) => {
                                // Test batch binding
                                let tensor_map = std::collections::HashMap::from([
                                    ("matrix_a".to_string(), (&tensor_a, AccessPattern::Input)),
                                    ("matrix_b".to_string(), (&tensor_b, AccessPattern::Input)),
                                    ("matrix_c".to_string(), (&tensor_c, AccessPattern::Output)),
                                ]);

                                match binding.bind_tensors_batch(tensor_map) {
                                    Ok(()) => {
                                        println!("✓ Batch tensor binding successful");

                                        // Verify all bindings are complete
                                        assert!(
                                            binding.is_complete(),
                                            "All required parameters should be bound"
                                        );

                                        // Check individual bindings
                                        for param in ["matrix_a", "matrix_b", "matrix_c"] {
                                            if let Some(binding_info) = binding.get_binding(param) {
                                                println!(
                                                    "  {}: {} elements, validated: {}",
                                                    param,
                                                    binding_info.tensor_size,
                                                    binding_info.is_validated
                                                );
                                            }
                                        }

                                        println!("✓ Batch binding validation passed");
                                    }
                                    Err(e) => println!("⚠️ Batch binding failed: {}", e),
                                }
                            }
                            Err(e) => println!("⚠️ Algorithm binding creation failed: {}", e),
                        }
                    }
                    Err(e) => println!("⚠️ Algorithm creation failed: {}", e),
                }
            }
            _ => println!("⚠️ Failed to create matrix tensors"),
        }
    }
}

#[test]
fn test_binding_template_validation() {
    println!("Testing binding template validation logic...");

    // Test elementwise binary operation template
    let elementwise_template = CommonBindingTemplates::elementwise_binary_op();

    assert_eq!(elementwise_template.name, "elementwise_binary_op");
    assert_eq!(elementwise_template.required_params.len(), 3);
    assert_eq!(elementwise_template.optional_params.len(), 0);

    // Verify parameter specifications
    let param_names: Vec<&String> = elementwise_template
        .required_params
        .iter()
        .map(|p| &p.name)
        .collect();
    assert!(param_names.contains(&&"input_a".to_string()));
    assert!(param_names.contains(&&"input_b".to_string()));
    assert!(param_names.contains(&&"output".to_string()));

    // Test validation rules
    assert_eq!(elementwise_template.validation_rules.len(), 1);
    match &elementwise_template.validation_rules[0] {
        ValidationRule::SameSizeRequired(params) => {
            assert_eq!(params.len(), 3);
            assert!(params.contains(&"input_a".to_string()));
            assert!(params.contains(&"input_b".to_string()));
            assert!(params.contains(&"output".to_string()));
        }
        _ => panic!("Expected SameSizeRequired validation rule"),
    }

    println!("✓ Elementwise template validation passed");

    // Test matrix multiplication template
    let matrix_template = CommonBindingTemplates::matrix_multiply();

    assert_eq!(matrix_template.name, "matrix_multiply");
    assert_eq!(matrix_template.required_params.len(), 3);

    // Check for matrix compatibility validation rule
    let has_matrix_rule = matrix_template
        .validation_rules
        .iter()
        .any(|rule| matches!(rule, ValidationRule::MatrixCompatible { .. }));
    assert!(
        has_matrix_rule,
        "Matrix template should have matrix compatibility rule"
    );

    println!("✓ Matrix template validation passed");

    // Test reduction template
    let reduction_template = CommonBindingTemplates::reduction();

    assert_eq!(reduction_template.name, "reduction");
    assert_eq!(reduction_template.required_params.len(), 2);

    // Verify output parameter has size constraint
    let output_param = reduction_template
        .required_params
        .iter()
        .find(|p| p.name == "output")
        .expect("Reduction template should have output parameter");

    assert_eq!(
        output_param.max_size,
        Some(1),
        "Reduction output should be limited to 1 element"
    );

    println!("✓ Reduction template validation passed");
    println!("✓ All binding template validation tests passed");
}

#[test]
fn test_tensor_data_type_validation() {
    println!("Testing tensor data type validation...");

    // Test data type enumeration
    assert_eq!(std::mem::size_of::<f32>(), 4);
    assert_eq!(std::mem::size_of::<f64>(), 8);
    assert_eq!(std::mem::size_of::<i32>(), 4);
    assert_eq!(std::mem::size_of::<u32>(), 4);

    // Test data type matching
    let f32_type = TensorDataType::F32;
    let f64_type = TensorDataType::F64;
    let i32_type = TensorDataType::I32;
    let u32_type = TensorDataType::U32;

    assert_ne!(f32_type, f64_type);
    assert_ne!(i32_type, u32_type);

    // Test parameter specification with different data types
    let param_f32 = ParameterSpec {
        name: "test_f32".to_string(),
        data_type: TensorDataType::F32,
        min_size: 1,
        max_size: None,
        access_pattern: AccessPattern::Input,
        description: "Test f32 parameter".to_string(),
    };

    let param_f64 = ParameterSpec {
        name: "test_f64".to_string(),
        data_type: TensorDataType::F64,
        min_size: 1,
        max_size: None,
        access_pattern: AccessPattern::Input,
        description: "Test f64 parameter".to_string(),
    };

    assert_ne!(param_f32.data_type, param_f64.data_type);

    println!("✓ Tensor data type validation passed");
}

#[test]
fn test_access_pattern_optimization() {
    println!("Testing access pattern optimization hints...");

    let access_patterns = vec![
        AccessPattern::Input,
        AccessPattern::Output,
        AccessPattern::InputOutput,
        AccessPattern::Uniform,
    ];

    for pattern in access_patterns {
        // Each access pattern should have different optimization characteristics
        match pattern {
            AccessPattern::Input => {
                println!("  Input pattern: Read-only optimization");
            }
            AccessPattern::Output => {
                println!("  Output pattern: Write-only optimization");
            }
            AccessPattern::InputOutput => {
                println!("  InputOutput pattern: Read-write synchronization");
            }
            AccessPattern::Uniform => {
                println!("  Uniform pattern: Small, frequently accessed data");
            }
        }
    }

    println!("✓ Access pattern optimization test passed");
}

#[test]
#[ignore = "requires GPU device"]
fn test_binding_error_handling() {
    if let Ok(mut manager) = Manager::new() {
        println!("Testing algorithm binding error handling...");

        // Create a simple test tensor
        let test_data = vec![1.0f32, 2.0, 3.0];
        if let Ok(tensor) = Tensor::new(&mut manager, &test_data) {
            // Use real SPIR-V for testing
            let spirv_data = kompute::spirv_shaders::ELEMENTWISE_ADD_F32_SPIRV;

            if let Ok(algorithm) = Algorithm::new(&mut manager, spirv_data) {
                let template = CommonBindingTemplates::elementwise_binary_op();
                if let Ok(mut binding) = AlgorithmBinding::new(algorithm, Some(&template)) {
                    // Test binding to invalid parameter name
                    match binding.bind_tensor_validated(
                        "invalid_param",
                        &tensor,
                        AccessPattern::Input,
                    ) {
                        Ok(_) => panic!("Should have failed with invalid parameter name"),
                        Err(e) => {
                            assert!(e
                                .to_string()
                                .contains("not defined in the binding template"));
                            println!("✓ Invalid parameter name error correctly handled");
                        }
                    }

                    // Test empty parameter name
                    match binding.bind_tensor_validated("", &tensor, AccessPattern::Input) {
                        Ok(_) => panic!("Should have failed with empty parameter name"),
                        Err(e) => {
                            assert!(e.to_string().contains("Parameter name cannot be empty"));
                            println!("✓ Empty parameter name error correctly handled");
                        }
                    }

                    // Test incomplete binding validation
                    let report = binding.validation_report();
                    assert!(
                        !report.is_valid,
                        "Binding should be invalid with missing required parameters"
                    );
                    assert!(
                        !report.missing_required.is_empty(),
                        "Should report missing required parameters"
                    );

                    println!("✓ Binding validation correctly reports incomplete state");
                    println!("  Missing required: {:?}", report.missing_required);
                }
            }
        }

        println!("✓ Algorithm binding error handling tests completed");
    }
}

#[test]
fn test_performance_hint_generation() {
    println!("Testing performance hint generation...");

    // Test different access patterns and their hints
    let access_patterns = vec![
        (AccessPattern::Input, "Read-only access"),
        (AccessPattern::Output, "Write-only access"),
        (AccessPattern::InputOutput, "Read-write access"),
        (AccessPattern::Uniform, "Uniform data"),
    ];

    for (pattern, expected_hint) in access_patterns {
        println!("  Testing access pattern: {:?}", pattern);

        // Create parameter spec with this access pattern
        let param_spec = ParameterSpec {
            name: "test_param".to_string(),
            data_type: TensorDataType::F32,
            min_size: 1,
            max_size: None,
            access_pattern: pattern,
            description: format!("Test parameter with {:?} access", pattern),
        };

        assert_eq!(param_spec.access_pattern, pattern);
        println!("    ✓ Parameter spec created for {:?}", pattern);
    }

    println!("✓ Performance hint generation test passed");
}

#[test]
fn test_binding_template_custom_creation() {
    println!("Testing custom binding template creation...");

    // Create a custom template for a hypothetical convolution operation
    let convolution_template = BindingTemplate {
        name: "convolution_2d".to_string(),
        required_params: vec![
            ParameterSpec {
                name: "input_image".to_string(),
                data_type: TensorDataType::F32,
                min_size: 1,
                max_size: None,
                access_pattern: AccessPattern::Input,
                description: "Input image tensor".to_string(),
            },
            ParameterSpec {
                name: "kernel".to_string(),
                data_type: TensorDataType::F32,
                min_size: 1,
                max_size: Some(1024), // Reasonable kernel size limit
                access_pattern: AccessPattern::Input,
                description: "Convolution kernel".to_string(),
            },
            ParameterSpec {
                name: "output_image".to_string(),
                data_type: TensorDataType::F32,
                min_size: 1,
                max_size: None,
                access_pattern: AccessPattern::Output,
                description: "Output convolved image".to_string(),
            },
        ],
        optional_params: vec![ParameterSpec {
            name: "bias".to_string(),
            data_type: TensorDataType::F32,
            min_size: 1,
            max_size: Some(256), // Channel bias
            access_pattern: AccessPattern::Input,
            description: "Optional bias values".to_string(),
        }],
        validation_rules: vec![ValidationRule::Custom(
            "validate_convolution_dimensions".to_string(),
        )],
        performance_hints: vec![
            "Use shared memory for kernel access".to_string(),
            "Consider tiling for large images".to_string(),
            "Optimize memory coalescing for image data".to_string(),
        ],
    };

    // Validate custom template structure
    assert_eq!(convolution_template.name, "convolution_2d");
    assert_eq!(convolution_template.required_params.len(), 3);
    assert_eq!(convolution_template.optional_params.len(), 1);
    assert_eq!(convolution_template.validation_rules.len(), 1);
    assert_eq!(convolution_template.performance_hints.len(), 3);

    // Check parameter specifications
    let kernel_param = convolution_template
        .required_params
        .iter()
        .find(|p| p.name == "kernel")
        .expect("Should have kernel parameter");

    assert_eq!(kernel_param.max_size, Some(1024));
    assert_eq!(kernel_param.access_pattern, AccessPattern::Input);

    let bias_param = convolution_template
        .optional_params
        .iter()
        .find(|p| p.name == "bias")
        .expect("Should have bias parameter");

    assert_eq!(bias_param.max_size, Some(256));

    // Check validation rule
    match &convolution_template.validation_rules[0] {
        ValidationRule::Custom(rule_name) => {
            assert_eq!(rule_name, "validate_convolution_dimensions");
        }
        _ => panic!("Expected custom validation rule"),
    }

    println!("✓ Custom convolution template created successfully");
    println!(
        "  Required parameters: {}",
        convolution_template.required_params.len()
    );
    println!(
        "  Optional parameters: {}",
        convolution_template.optional_params.len()
    );
    println!(
        "  Performance hints: {}",
        convolution_template.performance_hints.len()
    );

    println!("✓ Custom binding template creation test passed");
}
